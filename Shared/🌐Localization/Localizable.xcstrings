    },
    "%@ / %@" : {
      "comment" : "A text label displaying the current playback time and the total duration of a video segment. The first argument is the formatted current playback time. The second argument is the formatted total duration of the video segment.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"
